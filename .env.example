# Snowflake connection. Copy to .env and fill in.
#
# Authentication is key-pair only — there is no password variable. Generate the
# key pair per Snowflake's key-pair auth docs and register the public key on the
# user with ALTER USER <user> SET RSA_PUBLIC_KEY = '...'.

# Account identifier, e.g. abcd-xy12345 (no .snowflakecomputing.com suffix).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Path to the PKCS#8 private key. A relative path resolves against the repo root,
# not the current working directory. keys/ is gitignored.
SNOWFLAKE_PRIVATE_KEY_PATH=keys/rsa_key.p8

SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=FAERS_WH
SNOWFLAKE_DATABASE=FAERS_DB
# Default schema for the ingestion session. dbt sets its own schema per model
# layer via dbt_project.yml, so this only affects the Python/Snowpark side.
SNOWFLAKE_SCHEMA=RAW
