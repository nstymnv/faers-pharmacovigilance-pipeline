# Airflow's local settings. Copy to .env (gitignored) and fill in.

# Your host user id (`id -u`), so files Airflow writes into mounted folders —
# logs/, dbt_packages/ — stay owned by you.
AIRFLOW_UID=1000

# The Airflow UI admin, created by the airflow-init service on startup. Leave
# empty to start without one; after filling them in, re-run
#   docker compose up -d --force-recreate airflow-init
# Changing the password here later does not update an existing user — use
#   docker compose exec airflow-apiserver airflow users reset-password -u <user>
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=

# Signs the tokens the scheduler hands to running tasks. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=

# Encrypts connections stored in Airflow's database. Optional here, since the
# Snowflake connection below comes from the environment rather than the
# database, but set it to avoid storing anything in plain text later:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# The one Snowflake connection every task uses (conn id: faers_snowflake), with
# key-pair auth. Same values as the repo-root .env. private_key_file is the path
# INSIDE the container: the repo's keys/ is mounted read-only at /opt/airflow/keys.
AIRFLOW_CONN_FAERS_SNOWFLAKE='{"conn_type": "snowflake", "login": "<user>", "schema": "RAW", "extra": {"account": "<account>", "warehouse": "FAERS_WH", "database": "FAERS_DB", "role": "<role>", "private_key_file": "/opt/airflow/keys/rsa_key.p8"}}'
